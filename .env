# ===========================================================================
# WORKFLOW AUTOMATION FOR OPERATIONAL REPORTING - ENVIRONMENT CONFIGURATION
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. REPORT SCHEDULER CONFIGURATION
# ---------------------------------------------------------------------------
# Time of day to run the scheduled workflow (Format: HH:MM or HH:MM:SS)
REPORT_SCHEDULE_TIME=09:00

# Schedule frequency (DAILY)
REPORT_SCHEDULE_FREQUENCY=DAILY

# Catch-up mode: Automatically run missed reports on startup if laptop was offline at scheduled time (true/false)
REPORT_SCHEDULE_CATCHUP=true

# ---------------------------------------------------------------------------
# 2. TESTING CONFIGURATION (UNCOMMENT TO USE)
# ---------------------------------------------------------------------------
# To run scheduler every 1 minute (60 seconds) for testing, uncomment below:
# REPORT_SCHEDULE_INTERVAL_SECONDS=60

# To run scheduler once and exit, uncomment below:
# REPORT_SCHEDULE_ONCE=true

# ---------------------------------------------------------------------------
# 3. OPTIONAL CONFLUENCE PUBLISHING CONFIGURATION (UNCOMMENT TO USE)
# ---------------------------------------------------------------------------
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
# CONFLUENCE_EMAIL=your-email@example.com
# CONFLUENCE_API_TOKEN=your-atlassian-api-token
# CONFLUENCE_SPACE_KEY=OPS
# CONFLUENCE_PAGE_ID=
